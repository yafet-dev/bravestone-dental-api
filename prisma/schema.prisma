generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id            String         @id
  name          String
  price         Int
  summary       String
  features      PlanFeature[]
  organizations Organization[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("plans")
}

model PlanFeature {
  id                       String                        @id @default(cuid())
  planId                   String
  label                    String
  enabled                  Boolean                       @default(true)
  sortOrder                Int                           @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  plan                     Plan                          @relation(fields: [planId], references: [id], onDelete: Cascade)
  disabledForOrganizations OrganizationDisabledFeature[]

  @@index([planId, sortOrder])
  @@map("plan_features")
}

model Organization {
  id                         String                        @id @default(cuid())
  name                       String
  legalName                  String?
  owner                      String
  ownerEmail                 String
  contactPhone               String?
  licenseNumber              String?
  assistantMessages          Json?
  doctorProfileNotifications Json?
  planId                     String
  status                     String
  paymentStatus              String
  dueDate                    DateTime
  lifetimePaid               Int                           @default(0)
  lastPaidAt                 DateTime?
  lastUnpaidAt               DateTime?
  unpaidReason               String?
  unpaidEmailSent            Boolean                       @default(false)
  featuresPaused             Boolean                       @default(false)
  aiMonthlyLimit             Int                           @default(0)
  aiUsedThisMonth            Int                           @default(0)
  aiTotalChecks              Int                           @default(0)
  aiChecksToday              Int                           @default(0)
  aiResetDate                DateTime
  aiLastUsedAt               DateTime?
  dashboardAppointmentsToday Int                           @default(0)
  dashboardMonthlyRevenue    Int                           @default(0)
  dashboardLowStockItems     Int                           @default(0)
  dashboardPendingForms      Int                           @default(0)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  plan                       Plan                          @relation(fields: [planId], references: [id])
  branches                   Branch[]
  users                      User[]
  invitations                Invitation[]
  paymentHistory             PaymentRecord[]
  disabledFeatures           OrganizationDisabledFeature[]
  clinicRoles                ClinicRole[]
  clinicWorkspaceState       ClinicWorkspaceState?
  clinicPatients             ClinicPatient[]
  clinicPatientProfiles      ClinicPatientProfile[]
  clinicPatientPayments      ClinicPatientPayment[]
  clinicDoctors              ClinicDoctor[]
  clinicAppointments         ClinicAppointment[]
  clinicRevenuePoints        ClinicRevenuePoint[]
  clinicProcedures           ClinicProcedure[]
  clinicDiagnoses            ClinicDiagnosis[]
  clinicSymptoms             ClinicSymptom[]
  clinicPrescriptions        ClinicPrescription[]
  clinicInvoices             ClinicInvoice[]
  clinicForms                ClinicForm[]
  clinicSickLeaves           ClinicSickLeave[]
  clinicReports              ClinicReport[]
  clinicFinanceEntries       ClinicFinanceEntry[]

  @@index([planId])
  @@index([status])
  @@index([paymentStatus])
  @@map("organizations")
}

model OrganizationDisabledFeature {
  id             String       @id @default(cuid())
  organizationId String
  featureId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature        PlanFeature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureId])
  @@index([featureId])
  @@map("organization_disabled_features")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  city           String
  manager        String
  patientsCount  Int          @default(0)
  status         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]       @relation("UserBranch")
  defaultUsers   User[]       @relation("UserDefaultBranch")
  invitations    Invitation[]

  @@index([organizationId])
  @@index([status])
  @@map("branches")
}

model User {
  id                  String        @id @default(cuid())
  authUserId          String?       @unique
  organizationId      String?
  branchId            String?
  defaultBranchId     String?
  email               String        @unique
  fullName            String
  role                String
  status              String        @default("invited")
  avatarUrl           String?
  phone               String?
  emailSignature      String?
  preferences         Json?
  lastActiveAt        DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch              Branch?       @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)
  defaultBranch       Branch?       @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  invitationsAccepted Invitation[]  @relation("InvitationAcceptedBy")

  @@index([organizationId])
  @@index([branchId])
  @@index([defaultBranchId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model ClinicRole {
  id             String       @id @default(cuid())
  organizationId String
  role           String
  access         String
  features       Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@map("clinic_roles")
}

model ClinicPatient {
  id                String               @id
  organizationId    String
  name              String
  age               Int
  gender            String
  phone             String
  email             String
  lastVisit         String
  status            String
  balance           Int                  @default(0)
  medicalHistory    Json
  dentalChart       Json
  notes             Json
  emergencyContacts Json
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientProfile    ClinicPatientProfile?
  payments          ClinicPatientPayment[]
  appointments      ClinicAppointment[]
  diagnoses         ClinicDiagnosis[]
  symptoms          ClinicSymptom[]
  prescriptions     ClinicPrescription[]
  invoices          ClinicInvoice[]
  forms             ClinicForm[]
  sickLeaves        ClinicSickLeave[]

  @@index([organizationId])
  @@index([status])
  @@map("clinic_patients")
}

model ClinicPatientProfile {
  patientId         String        @id
  organizationId    String
  directoryId       String
  dob               String
  address           String
  branchId          String
  branchName        String
  bloodGroup        String
  nextAppointment   String?
  paymentPlan       Json
  pendingAmount     Int           @default(0)
  recordCount       Int           @default(0)
  cardNumber        String
  registrationTime  String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient           ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@map("clinic_patient_profiles")
}

model ClinicPatientPayment {
  id             String        @id
  organizationId String
  patientId      String
  date           String
  amount         Int
  method         String
  receivedBy     String
  note           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([patientId])
  @@map("clinic_patient_payments")
}

model ClinicDoctor {
  id                String              @id
  organizationId    String
  name              String
  specialty         String
  schedule          String
  availability      String
  assignedPatients  Int                 @default(0)
  revenue           Int                 @default(0)
  procedures        Int                 @default(0)
  rating            Int                 @default(0)
  weeklyAvailability Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments      ClinicAppointment[]
  diagnoses         ClinicDiagnosis[]
  prescriptions     ClinicPrescription[]
  sickLeaves        ClinicSickLeave[]

  @@index([organizationId])
  @@index([availability])
  @@map("clinic_doctors")
}

model ClinicAppointment {
  id             String        @id
  organizationId String
  patientId      String
  doctorId       String
  patientName    String
  doctorName     String
  date           String
  time           String
  duration       Int
  type           String
  status         String
  reason         String?
  createdNow     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor         ClinicDoctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
  @@map("clinic_appointments")
}

model ClinicRevenuePoint {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  revenue        Int
  patients       Int
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sortOrder])
  @@map("clinic_revenue_points")
}

model ClinicProcedure {
  id             String       @id
  organizationId String
  name           String
  category       String
  cost           Int
  duration       String
  followUp       String
  patient        String
  doctor         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("clinic_procedures")
}

model ClinicDiagnosis {
  id             String        @id
  organizationId String
  patientId      String?
  doctorId       String?
  patient        String
  tooth          String
  diagnosis      String
  severity       String
  date           String
  doctor         String
  complaint      String?
  doctorAction   String?
  medicine       String?
  followUp       String?
  attachments    Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord  ClinicPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctorRecord   ClinicDoctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
  @@map("clinic_diagnoses")
}

model ClinicSymptom {
  id             String        @id
  organizationId String
  patientId      String?
  patient        String
  date           String
  tooth          String
  pain           Int
  sensitivity    String
  bleeding       String
  swelling       String
  infection      String
  notes          String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord  ClinicPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([patientId])
  @@map("clinic_symptoms")
}

model ClinicPrescription {
  id             String        @id
  organizationId String
  patientId      String?
  doctorId       String?
  patient        String
  doctor         String
  medicine       String
  dosage         String
  duration       String
  status         String
  date           String
  instructions   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord  ClinicPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctorRecord   ClinicDoctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
  @@map("clinic_prescriptions")
}

model ClinicInvoice {
  id             String        @id
  organizationId String
  patientId      String?
  billToName     String
  date           String
  amount         Int
  status         String
  items          Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord  ClinicPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([patientId])
  @@map("clinic_invoices")
}

model ClinicForm {
  id             String        @id
  organizationId String
  patientId      String?
  patient        String
  type           String
  status         String
  owner          String
  updated        String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord  ClinicPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([patientId])
  @@map("clinic_forms")
}

model ClinicSickLeave {
  id             String        @id
  organizationId String
  patientId      String?
  doctorId       String?
  patient        String
  doctor         String
  diagnosis      String
  start          String
  end            String
  status         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord  ClinicPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctorRecord   ClinicDoctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
  @@map("clinic_sick_leaves")
}

model ClinicReport {
  id             String       @id
  organizationId String
  name           String
  type           String
  range          String
  format         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("clinic_reports")
}

model ClinicFinanceEntry {
  id             String       @id
  organizationId String
  type           String
  date           String
  category       String
  description    String
  party          String
  owner          String
  amount         Decimal      @db.Decimal(12, 2)
  status         String
  frequency      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("clinic_finance_entries")
}

model Invitation {
  id               String       @id @default(cuid())
  organizationId   String
  branchId         String?
  acceptedByUserId String?
  email            String
  role             String
  sentAt           DateTime
  expiresAt        DateTime
  status           String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  acceptedByUser   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@map("invitations")
}

model PaymentRecord {
  id             String       @id @default(cuid())
  organizationId String
  invoiceNumber  String       @unique
  paidAt         DateTime
  method         String
  amount         Int
  reference      String
  note           String
  planName       String
  recordedAt     DateTime
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([paidAt])
  @@map("payment_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  detail    String
  tone      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model SuperAdminProfile {
  id                 String   @id
  name               String
  email              String
  recoveryEmail      String
  twoFactorEnabled   Boolean  @default(false)
  lastPasswordChange DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("super_admin_profiles")
}

model ClinicWorkspaceState {
  id                 String        @id
  organizationId     String?       @unique
  patients           Json
  patientProfiles    Json
  patientPayments    Json
  appointments       Json
  revenueData        Json
  doctors            Json
  procedures         Json
  diagnoses          Json
  symptoms           Json
  prescriptions      Json
  invoices           Json
  forms              Json
  sickLeaves         Json
  reports            Json
  staffUsers         Json
  roles              Json
  rolePermissions    Json
  branches           Json
  organizationProfile Json
  financeEntries     Json
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("clinic_workspace_states")
}
