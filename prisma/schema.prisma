  doctor         String
  complaint      String?
  doctorAction   String?
  medicine       String?
  followUp       String?
  attachments    Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord  ClinicPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctorRecord   ClinicDoctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)

