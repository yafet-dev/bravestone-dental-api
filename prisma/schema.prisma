  duration       Int
  type           String
  status         String
  reason         String?
  createdNow     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor         ClinicDoctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
  @@map("clinic_appointments")
}

model ClinicRevenuePoint {
  id             String       @id @default(cuid())
  organizationId String
