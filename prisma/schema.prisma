/// A doctor telling reception "I am free now", and reception answering with the
/// patient to send in. Kept in its own table rather than inside the workspace
/// JSON blob because it is the one record in the app that has to arrive in
/// under a second: a small row means a small write, a small read, and no
/// read-modify-write race when two receptionists answer the same signal.
model CareHandoff {
  id                  String       @id
  organizationId      String
  branchId            String
  doctorId            String
  doctorName          String
  doctorSpecialty     String
  requestedByMemberId String
  requestedAt         DateTime
  status              String
  patientId           String?
  patientName         String?
  appointmentId       String?
  assignedByMemberId  String?
  assignedByName      String?
  assignedAt          DateTime?
  acknowledgedAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Reception lists open signals for its branch; the doctor watches its own.
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, doctorId, status])
  @@map("care_handoffs")
}

/// A patient image held in object storage rather than in the workspace snapshot.
///
/// Record images used to be base64 `dataUrl` strings inside the clinic workspace
/// JSON, so every photo inflated a single Postgres row and was fetched in full on
/// every page load. The bytes now live in a private bucket; this row is the index,
/// the permission boundary, and the audit trail.
///
/// `storagePath` is never handed to a browser. Reads go through the API, which
/// checks the caller's organization and issues a short-lived signed URL.
model PatientAttachment {
  id             String   @id @default(cuid())
  organizationId String
  /// Workspace patient id (e.g. "p1"), not a foreign key: the workspace snapshot
  /// owns patient identity and can be rewritten wholesale by a clinic admin.
  patientId      String
  /// Which record entry inside the patient's history this belongs to, when known.
  recordId       String?
  /// Original file name, kept for display and download only. Never used to build
  /// the storage path, so a hostile name cannot escape its folder.
  fileName       String
  /// Mime type of the *stored* object, after re-encoding.
  contentType    String
  /// Path inside the bucket. Opaque to clients.
  storagePath    String   @unique
  bytes          Int
  width          Int?
  height         Int?
  /// True when the image was treated as diagnostic and kept near-lossless.
  isRadiograph   Boolean  @default(false)
  /// SHA-256 of the stored bytes, so a corrupted or swapped object is detectable.
  checksum       String
  /// Account that uploaded it. Kept as a plain id so deleting a staff member does
  /// not erase who added a clinical image.
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, createdAt])
  @@map("patient_attachments")
}
