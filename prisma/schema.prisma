model ClinicWorkspaceState {
  id                  String        @id
  organizationId      String?       @unique
  patients            Json
  patientProfiles     Json
  patientPayments     Json
  appointments        Json
  revenueData         Json
  doctors             Json
  procedures          Json
  diagnoses           Json
  symptoms            Json
  prescriptions       Json
  invoices            Json
  forms               Json
  sickLeaves          Json
  reports             Json
  staffUsers          Json
  roles               Json
