model ClinicFinanceEntry {
  id               String       @id
  organizationId   String
  type             String
  date             String
  category         String
  description      String
  party            String
  owner            String
  amount           Decimal      @db.Decimal(12, 2)
  status           String
  frequency        String
  // Monthly recurrence. `seriesId` ties every occurrence of one repeating item
  // together, `recurrence` is 'active' | 'stopped', `generatedThrough` is the
  // 'YYYY-MM' watermark of the last month already booked for the series, and
  // `autoAdded` marks rows the roll-forward created rather than a person.
  seriesId         String?
  recurrence       String?
  generatedThrough String?
  autoAdded        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([seriesId])
  @@map("clinic_finance_entries")
}

