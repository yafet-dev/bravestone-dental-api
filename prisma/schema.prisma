generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id            String         @id
  name          String
  price         Int
  summary       String
  features      PlanFeature[]
  organizations Organization[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("plans")
}

model PlanFeature {
  id                       String                        @id @default(cuid())
  planId                   String
  label                    String
  enabled                  Boolean                       @default(true)
  sortOrder                Int                           @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  plan                     Plan                          @relation(fields: [planId], references: [id], onDelete: Cascade)
  disabledForOrganizations OrganizationDisabledFeature[]

  @@index([planId, sortOrder])
  @@map("plan_features")
}

model Organization {
  id                         String                        @id @default(cuid())
  name                       String
  legalName                  String?
  owner                      String
  ownerEmail                 String
  contactPhone               String?
  licenseNumber              String?
  assistantMessages          Json?
  doctorProfileNotifications Json?
  planId                     String
  status                     String
  paymentStatus              String
  dueDate                    DateTime
  lifetimePaid               Int                           @default(0)
  lastPaidAt                 DateTime?
  lastUnpaidAt               DateTime?
  unpaidReason               String?
  unpaidEmailSent            Boolean                       @default(false)
  featuresPaused             Boolean                       @default(false)
  aiMonthlyLimit             Int                           @default(0)
  aiUsedThisMonth            Int                           @default(0)
  aiTotalChecks              Int                           @default(0)
  aiChecksToday              Int                           @default(0)
  aiResetDate                DateTime
  aiLastUsedAt               DateTime?
  /// Weekly AI spend cap, in millionths of a USD ($1.00 = 1_000_000). Integer
  /// micro-dollars rather than a float so repeated small additions cannot drift.
  aiWeeklyBudgetMicroUsd     Int                           @default(1000000)
  aiWeekSpentMicroUsd        Int                           @default(0)
  /// When the current weekly window ends. Null until the clinic's first AI call.
  aiWeekResetAt              DateTime?
  aiWeekInputTokens          Int                           @default(0)
  aiWeekOutputTokens         Int                           @default(0)
  /// Readable clinic segment of the public price board URL, claimed once so a
  /// published link survives a rename. Null until an admin generates the link.
  priceBoardSlug             String?                       @unique
  /// Short code that makes the board URL unguessable. Rotating it replaces this
  /// value; clearing it turns the public board off and keeps the slug reserved.
  priceBoardCode             String?
  dashboardAppointmentsToday Int                           @default(0)
  dashboardMonthlyRevenue    Int                           @default(0)
  dashboardLowStockItems     Int                           @default(0)
  dashboardPendingForms      Int                           @default(0)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  plan                       Plan                          @relation(fields: [planId], references: [id])
  branches                   Branch[]
  users                      User[]
  invitations                Invitation[]
  paymentHistory             PaymentRecord[]
  disabledFeatures           OrganizationDisabledFeature[]
  clinicRoles                ClinicRole[]
  clinicWorkspaceState       ClinicWorkspaceState?
  clinicPatients             ClinicPatient[]
  clinicPatientProfiles      ClinicPatientProfile[]
  clinicPatientPayments      ClinicPatientPayment[]
  clinicDoctors              ClinicDoctor[]
  clinicAppointments         ClinicAppointment[]
  clinicRevenuePoints        ClinicRevenuePoint[]
  clinicProcedures           ClinicProcedure[]
  clinicDiagnoses            ClinicDiagnosis[]
  clinicSymptoms             ClinicSymptom[]
  clinicPrescriptions        ClinicPrescription[]
  clinicInvoices             ClinicInvoice[]
  clinicForms                ClinicForm[]
  clinicSickLeaves           ClinicSickLeave[]
  clinicReports              ClinicReport[]
  clinicFinanceEntries       ClinicFinanceEntry[]
  careHandoffs               CareHandoff[]
  patientAttachments         PatientAttachment[]

  @@index([planId])
  @@index([status])
  @@index([paymentStatus])
  @@map("organizations")
}

model OrganizationDisabledFeature {
  id             String       @id @default(cuid())
  organizationId String
  featureId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature        PlanFeature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureId])
  @@index([featureId])
  @@map("organization_disabled_features")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  city           String
  manager        String
  patientsCount  Int          @default(0)
  status         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]       @relation("UserBranch")
  defaultUsers   User[]       @relation("UserDefaultBranch")
  invitations    Invitation[]

  @@index([organizationId])
  @@index([status])
  @@map("branches")
}

model User {
  id                  String                    @id @default(cuid())
  authUserId          String?                   @unique
  organizationId      String?
  branchId            String?
  defaultBranchId     String?
  email               String                    @unique
  fullName            String
  role                String
  status              String                    @default("invited")
  passwordHash        String?
  emailVerifiedAt     DateTime?
  mustChangePassword  Boolean                   @default(false)
  authVersion         Int                       @default(0)
  avatarUrl           String?
  phone               String?
  emailSignature      String?
  preferences         Json?
  lastActiveAt        DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  organization        Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch              Branch?                   @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)
  defaultBranch       Branch?                   @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  invitationsAccepted Invitation[]              @relation("InvitationAcceptedBy")
  invitationsSent     Invitation[]              @relation("InvitationInvitedBy")
  authTokens          AuthToken[]
  authSessions        AuthSession[]
  twoFactorCredential UserTwoFactorCredential?
  twoFactorChallenges TwoFactorLoginChallenge[]

  @@index([organizationId])
  @@index([branchId])
  @@index([defaultBranchId])
  @@index([role])
  @@index([status])
  @@map("users")
}

/// Server-owned login sessions. The bearer token itself is never stored; only
/// its SHA-256 digest is retained so one device can be revoked without rotating
/// every session belonging to the account.
model AuthSession {
  id          String    @id
  userId      String
  authVersion Int
  tokenHash   String    @unique
  userAgent   String?
  browser     String
  os          String
  deviceType  String
  deviceLabel String
  ipAddress   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, authVersion, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Single-use email tokens the backend owns outright: address verification and
/// password recovery. Only the SHA-256 hash of the token is stored, so a leaked
/// database row cannot be replayed as a working link.
model AuthToken {
  id         String    @id @default(cuid())
  userId     String
  type       String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// A user's authenticator-app credential. The shared TOTP secret is encrypted
/// with AES-256-GCM by the API; plaintext secrets and provisioning URIs never
/// reach the database.
model UserTwoFactorCredential {
  userId           String                  @id
  encryptedSecret  String
  keyVersion       Int                     @default(1)
  enabledAt        DateTime?
  setupExpiresAt   DateTime?
  lastUsedTimeStep Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes    TwoFactorRecoveryCode[]

  @@map("user_two_factor_credentials")
}

/// High-entropy, single-use recovery codes. The visible code is returned once;
/// only a keyed SHA-256 digest remains after enrollment.
model TwoFactorRecoveryCode {
  id         String                  @id @default(cuid())
  userId     String
  codeIndex  Int
  codeHash   String
  usedAt     DateTime?
  createdAt  DateTime                @default(now())
  credential UserTwoFactorCredential @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, codeIndex])
  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

/// Opaque, short-lived pre-authentication state created only after the password
/// is correct. No bearer session is issued until this challenge is consumed.
model TwoFactorLoginChallenge {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  attempts     Int       @default(0)
  lastFailedAt DateTime?
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([userId, lastFailedAt])
  @@index([expiresAt])
  @@map("two_factor_login_challenges")
}

model ClinicRole {
  id             String       @id @default(cuid())
  organizationId String
  role           String
  access         String
  features       Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@map("clinic_roles")
}

model ClinicPatient {
  id                String                 @id
  organizationId    String
  name              String
  age               Int
  gender            String
  phone             String
  email             String
  lastVisit         String
  status            String
  balance           Int                    @default(0)
  medicalHistory    Json
  dentalChart       Json
  notes             Json
  emergencyContacts Json
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientProfile    ClinicPatientProfile?
  payments          ClinicPatientPayment[]
  appointments      ClinicAppointment[]
  diagnoses         ClinicDiagnosis[]
  symptoms          ClinicSymptom[]
  prescriptions     ClinicPrescription[]
  invoices          ClinicInvoice[]
  forms             ClinicForm[]
  sickLeaves        ClinicSickLeave[]

  @@index([organizationId])
  @@index([status])
  @@map("clinic_patients")
}

model ClinicPatientProfile {
  patientId        String        @id
  organizationId   String
  directoryId      String
  dob              String
  address          String
  branchId         String
  branchName       String
  bloodGroup       String
  nextAppointment  String?
  paymentPlan      Json
  pendingAmount    Int           @default(0)
  recordCount      Int           @default(0)
  cardNumber       String
  registrationTime String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient          ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@map("clinic_patient_profiles")
}

model ClinicPatientPayment {
  id             String        @id
  organizationId String
  patientId      String
  date           String
  amount         Int
  method         String
  receivedBy     String
  note           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([patientId])
  @@map("clinic_patient_payments")
}

model ClinicDoctor {
  id                 String               @id
  organizationId     String
  name               String
  specialty          String
  schedule           String
  availability       String
  assignedPatients   Int                  @default(0)
  revenue            Int                  @default(0)
  procedures         Int                  @default(0)
  rating             Int                  @default(0)
  weeklyAvailability Json
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments       ClinicAppointment[]
  diagnoses          ClinicDiagnosis[]
  prescriptions      ClinicPrescription[]
  sickLeaves         ClinicSickLeave[]

  @@index([organizationId])
  @@index([availability])
  @@map("clinic_doctors")
}

model ClinicAppointment {
  id             String        @id
  organizationId String
  patientId      String
  doctorId       String
  patientName    String
  doctorName     String
  date           String
