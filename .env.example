PORT=4000
APP_URL="http://localhost:4000"
# Origin the browser app runs on. Verification, reset, and invitation links in
# outbound email are built against this (falls back to CORS_ORIGIN).
APP_PUBLIC_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
# Runtime application traffic (especially Vercel/serverless) must use the
# transaction pooler on port 6543.
DATABASE_URL="postgresql://postgres.okjjntxkksjtiyhwhokv:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migration, introspection, and other session-level tools use port 5432. The
# API does not use this value unless DATABASE_URL is absent.
DIRECT_URL="postgresql://postgres.okjjntxkksjtiyhwhokv:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Signs backend session tokens. Use a long random value per environment;
# changing it invalidates every active session.
AUTH_JWT_SECRET=""

# Encrypts per-user authenticator seeds and keys recovery-code digests. Use an
# independent value with at least 32 random bytes and keep it stable in a secret
# manager; rotating it requires a credential re-encryption migration.
TWO_FACTOR_ENCRYPTION_KEY=""

# SMTP relay used for every outbound email: address verification, password
# resets, and staff invitations. For Gmail, SMTP_PASS must be a 16-character
# app password, not the account password.
SMTP_FROM="Bravestone <you@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PASS=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="you@example.com"

# --- AI assistant spend cap -------------------------------------------------
# Each clinic organization gets a weekly token allowance worth a fixed amount of
# money (default $1.00, editable per clinic in the Super Admin console). Spend is
# metered from the token counts the provider reports on every call and priced
# with the two rates below, so THEY MUST MATCH the current price list for
# whatever DEEPSEEK_MODEL is set to — a wrong rate silently gives every clinic
# too much or too little AI. Both are USD per million tokens.
AI_INPUT_USD_PER_MTOK="0.3"
AI_OUTPUT_USD_PER_MTOK="1.2"

# Shown to clinics that have spent the week's allowance and want more. Falls back
# to SMTP_FROM when unset.
AI_BUDGET_CONTACT="sales@example.com"

# --- Patient record images (object storage) ---------------------------------
# Record photos and radiographs are stored in a PRIVATE Supabase Storage bucket,
# not in the database. They used to be base64 strings inside the clinic workspace
# row, which made every page load carry every image and grew the row without
# limit.
#
# Both values are in the Supabase dashboard under Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security: keep it server-side
# only, never expose it through a VITE_ variable, and never commit it. The API
# is the only thing that holds it. After an authenticated organization check,
# browsers receive a private signed read URL that expires after 120 seconds.
#
# Run `npm run storage:records` once to create the bucket and confirm it is
# private.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Bucket name. Only change this if you have already created a different one.
SUPABASE_RECORDS_BUCKET="patient-records"

# Development escape hatch. With no Supabase credentials the API would write
# patient images to ./uploads/records on the host, where they are lost on the
# next restart or deploy — so uploads are REFUSED unless this is "true". Never
# set it in production.
ALLOW_LOCAL_RECORD_STORAGE="false"
